 // Day 08 - Squares of a Sorted Array

#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> nums = {-4, -1, 0, 3, 10};

    int n = nums.size();

    vector<int> ans(n);

    int left = 0;
    int right = n - 1;
    int k = n - 1;

    while(left <= right) {

        int leftSquare = nums[left] * nums[left];
        int rightSquare = nums[right] * nums[right];

        if(leftSquare > rightSquare) {
            ans[k] = leftSquare;
            left++;
        }
        else {
            ans[k] = rightSquare;
            right--;
        }

        k--;
    }

    cout << "Sorted Squares: ";

    for(int i = 0; i < n; i++) {
        cout << ans[i] << " ";
    }

    return 0;
}

// Time Complexity: O(n)
// Space Complexity: O(n)
