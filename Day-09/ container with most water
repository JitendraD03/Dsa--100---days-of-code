 // Day 09 - Container With Most Water

#include <iostream>
#include <vector>
using namespace std;

int main() {
    vector<int> height = {1, 8, 6, 2, 5, 4, 8, 3, 7};

    int left = 0;
    int right = height.size() - 1;

    int maxArea = 0;

    while(left < right) {

        int h = min(height[left], height[right]);
        int width = right - left;

        int area = h * width;

        if(area > maxArea) {
            maxArea = area;
        }

        if(height[left] < height[right]) {
            left++;
        }
        else {
            right--;
        }
    }

    cout << "Maximum Water Area: " << maxArea;

    return 0;
}

// Time Complexity: O(n)
// Space Complexity: O(1)
