// Day 06 - Majority Element (LeetCode 169)

#include <iostream>
#include <vector>
using namespace std;

int main() {

    vector<int> nums = {3, 2, 3};

    int candidate = 0;
    int count = 0;

    for(int i = 0; i < nums.size(); i++) {

        if(count == 0) {
            candidate = nums[i];
        }

        if(nums[i] == candidate) {
            count++;
        }
        else {
            count--;
        }
    }

    cout << "Majority Element: " << candidate;

    return 0;
}

// Time Complexity: O(n)
// Space Complexity: O(1)
